# Copy to /etc/clp-sync/config.env on the PRIMARY server (chmod 600).
# Both hosts must be on the same Tailscale tailnet.

# Tailscale MagicDNS name or 100.x IP of the standby
STANDBY_HOST=cloudpanel-standby

# SSH user on standby (root recommended for ownership + clpctl)
STANDBY_SSH_USER=root
STANDBY_SSH_PORT=22

# Optional: path to dedicated SSH private key (default: root's)
# STANDBY_SSH_KEY=/root/.ssh/clp_sync_ed25519

# CloudPanel SQLite path (default is fine on stock installs)
CLP_DB_PATH=/home/clp/htdocs/app/data/db.sq3

# Working directories
CLP_SYNC_STATE_DIR=/var/lib/clp-sync
CLP_SYNC_TMP_DIR=/var/tmp/clp-sync
CLP_SYNC_LOG_DIR=/var/log/clp-sync

# Rsync exclude file (absolute path after install, or relative to repo)
RSYNC_EXCLUDES_FILE=/opt/clp-sync/excludes/rsync-excludes.txt

# Site types to provision on standby (comma-separated). Others are logged and skipped.
BOOTSTRAP_SITE_TYPES=php,nodejs,python,static,reverse-proxy

# Skip importing MySQL dumps when checksum matches last successful sync (1=yes)
MYSQL_SKIP_UNCHANGED=1

# MySQL system databases never dumped/imported
MYSQL_SKIP_DATABASES=information_schema,performance_schema,sys,mysql

# After nginx/ssl changes on standby, reload nginx (1=yes)
RELOAD_NGINX_ON_STANDBY=1

# Apply primary CloudPanel SQLite as the live panel DB on standby (admin users, sites, SSL metadata)
APPLY_PANEL_DB=1

# Extra Linux users to mirror password hashes / groups for (comma-separated)
SYNC_EXTRA_USERS=clp

# Optional: notify command on failure (empty = none)
# FAIL_NOTIFY_CMD='curl -fsS -d "clp-sync failed on $(hostname)" https://ntfy.sh/your-topic'
FAIL_NOTIFY_CMD=
