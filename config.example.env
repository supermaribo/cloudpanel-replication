# Generated by ./bin/install.sh (or copy manually). chmod 600.

# master = restricted SSH source (no timer)
# standby = puller (timer + rsync/mysqldump/import)
ROLE=standby

PROMOTED=0
SYNC_ENABLED=1
SYNC_AUTO=0
SYNC_INTERVAL=1h

# Live CloudPanel (Tailscale MagicDNS or 100.x) — replica pulls from here
MASTER_HOST=ip-172-26-10-13.tail13b07.ts.net
PRIMARY_HOST=
# Other paired host (used when this box is live and the peer pulls, or after a role swap)
PEER_HOST=lottie.tail13b07.ts.net
STANDBY_HOST=

MASTER_SSH_USER=root
MASTER_SSH_PORT=22
MASTER_SSH_KEY=/root/.ssh/clp_sync_ed25519

CLP_DB_PATH=/home/clp/htdocs/app/data/db.sq3
CLP_SYNC_STATE_DIR=/var/lib/clp-sync
CLP_SYNC_TMP_DIR=/var/tmp/clp-sync
CLP_SYNC_LOG_DIR=/var/log/clp-sync
RSYNC_EXCLUDES_FILE=/opt/clp-sync/excludes/rsync-excludes.txt
MYSQL_SKIP_DATABASES=information_schema,performance_schema,sys,mysql
RELOAD_NGINX_ON_STANDBY=1
APPLY_PANEL_DB=1
FAIL_NOTIFY_CMD=
DISPLAY_TZ=Europe/London
