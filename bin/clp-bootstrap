#!/usr/bin/env bash
# Full pull on the standby. Timer stays off until: clp-sync-control on
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/common.sh
source "${ROOT}/lib/common.sh"

require_root
load_config
[[ "${ROLE}" == "standby" ]] || die "Run clp-bootstrap on the standby (puller)"

systemctl disable --now clp-sync.timer 2>/dev/null || true
exec "${ROOT}/bin/clp-sync"
