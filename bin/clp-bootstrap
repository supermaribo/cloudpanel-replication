#!/usr/bin/env bash
# One-time / on-demand bootstrap: ensure standby has all sites + DBs, then full sync.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/common.sh
source "${ROOT}/lib/common.sh"
# shellcheck source=../lib/inventory.sh
source "${ROOT}/lib/inventory.sh"
# shellcheck source=../lib/sync-bootstrap.sh
source "${ROOT}/lib/sync-bootstrap.sh"
# shellcheck source=../lib/checks.sh
source "${ROOT}/lib/checks.sh"

# shellcheck source=../lib/promote.sh
source "${ROOT}/lib/promote.sh"

require_root
load_config

if [[ "${ROLE:-master}" == "standby" ]]; then
  die "This host is ROLE=standby — run bootstrap only on the master"
fi

config_set_kv "SYNC_AUTO" "0"
systemctl disable --now clp-sync.timer 2>/dev/null || true
systemctl stop clp-sync.service 2>/dev/null || true

CLP_SYNC_LOG_FILE="${CLP_SYNC_LOG_DIR}/bootstrap-$(date -u +%Y%m%d).log"
touch "${CLP_SYNC_LOG_FILE}"
chmod 600 "${CLP_SYNC_LOG_FILE}"

require_cmds ssh sqlite3 openssl clpctl
log_info "clp-bootstrap → ${STANDBY_HOST}"
log_info "Automatic 15-minute sync is OFF until this is stable (clp-sync-control on to re-enable)"

log_info "Running full compatibility checks before bootstrap"
checks_reset
run_local_preflight master || true
if ! run_peer_compatibility master; then
  die "Compatibility checks failed — fix issues before bootstrap"
fi

remote "echo ok && command -v clpctl" || die "Standby SSH/clpctl check failed"

DB_SNAP="$(inventory_snapshot)"
run_bootstrap "${DB_SNAP}"

log_info "Running full sync after bootstrap"
exec "${ROOT}/bin/clp-sync" --skip-bootstrap
