#!/usr/bin/env bash
# Enable or disable scheduled sync on the master.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/common.sh
source "${ROOT}/lib/common.sh"
# shellcheck source=../lib/promote.sh
source "${ROOT}/lib/promote.sh"

usage() {
  cat <<'EOF'
Usage: clp-sync-control <on|off|status>

Toggle the 15-minute pull timer on the standby.

  on      Enable the timer
  off     Disable (manual clp-sync still works)
  status  Show current setting
EOF
}

require_root
load_config 2>/dev/null || true

ACTION="${1:-status}"

case "${ACTION}" in
  on|enable)
    [[ "${ROLE:-standby}" == "standby" ]] || die "Timer runs on the standby (puller)"
    [[ -n "${MASTER_HOST:-}" ]] || die "Set MASTER_HOST first"
    toggle_sync on
    ;;
  off|disable)
    toggle_sync off
    ;;
  status)
    cfg="${CLP_SYNC_CONFIG:-/etc/clp-sync/config.env}"
    if [[ -f "${cfg}" ]]; then
      # shellcheck disable=SC1090
      source "${cfg}"
      echo "ROLE=${ROLE:-unknown}"
      echo "SYNC_ENABLED=${SYNC_ENABLED:-1}"
      echo "SYNC_AUTO=${SYNC_AUTO:-0}"
      echo "MASTER_HOST=${MASTER_HOST:-}"
      echo "PROMOTED=${PROMOTED:-0}"
      [[ "${PROMOTED:-0}" == "1" ]] && grep ^PROMOTED_AT= "${cfg}" || true
      echo -n "timer="
      systemctl is-enabled clp-sync.timer 2>/dev/null || echo "disabled"
      systemctl is-active clp-sync.timer 2>/dev/null || echo "timer=inactive"
    else
      echo "Not configured"
    fi
    ;;
  *)
    usage; exit 1
    ;;
esac
