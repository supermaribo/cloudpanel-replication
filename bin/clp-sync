#!/usr/bin/env bash
# clp-sync — standby pull mirror from the live master.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/common.sh
source "${ROOT}/lib/common.sh"
# shellcheck source=../lib/inventory.sh
source "${ROOT}/lib/inventory.sh"
# shellcheck source=../lib/pull.sh
source "${ROOT}/lib/pull.sh"

SKIP_FILES=0
SKIP_MYSQL=0
SKIP_NGINX=0
DRY_CONNECT_ONLY=0

usage() {
  cat <<'EOF'
Usage: clp-sync [options]

  Pull mirror: this standby fetches from MASTER_HOST over a read-only SSH key.

Options:
  --skip-files     Skip rsync of site homes
  --skip-mysql     Skip MySQL dump/import
  --skip-nginx     Skip nginx/PHP pull
  --connect-only   Probe master SSH, then exit
  -h, --help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --skip-files) SKIP_FILES=1 ;;
    --skip-mysql) SKIP_MYSQL=1 ;;
    --skip-nginx) SKIP_NGINX=1 ;;
    --connect-only) DRY_CONNECT_ONLY=1 ;;
    -h|--help) usage; exit 0 ;;
    *) die "Unknown option: $1" ;;
  esac
  shift
done

require_root
load_config

[[ "${ROLE}" == "standby" ]] || die "clp-sync now runs on the standby (ROLE=standby). Master only allows a restricted SSH key."

if [[ -n "${INVOCATION_ID:-}" && "${SYNC_AUTO:-0}" != "1" ]]; then
  echo "clp-sync: automatic sync is off (SYNC_AUTO=0)"
  echo "Enable with: /opt/clp-sync/bin/clp-sync-control on"
  exit 0
fi

[[ "${SYNC_ENABLED:-1}" == "1" ]] || die "SYNC_ENABLED=0"
[[ -n "${MASTER_HOST:-}" ]] || die "MASTER_HOST is not set"

CLP_SYNC_LOG_FILE="${CLP_SYNC_LOG_DIR}/sync-$(date -u +%Y%m%d).log"
touch "${CLP_SYNC_LOG_FILE}"
chmod 600 "${CLP_SYNC_LOG_FILE}"

LOCK_FILE="${CLP_SYNC_STATE_DIR}/clp-sync.lock"
exec 9>"${LOCK_FILE}"
if ! flock -n 9; then
  die "Another clp-sync run holds ${LOCK_FILE}"
fi

START_TS="$(date +%s)"
trap 'rc=$?; if [[ $rc -ne 0 ]]; then notify_failure "exit=$rc"; write_status failed "exit=$rc"; fi' EXIT

require_cmds ssh rsync sqlite3 flock timeout mysql
log_info "clp-sync pull ← ${MASTER_HOST}"

pull_probe || die "Cannot reach master (install pull key with clp-allow-pull)"

if [[ "${DRY_CONNECT_ONLY}" -eq 1 ]]; then
  log_ok "Connectivity OK"
  write_status ok "connect-only"
  trap - EXIT
  exit 0
fi

pull_panel_sqlite
DB_SNAP="${CLP_SYNC_TMP_DIR}/db.sq3"
log_info "Inventory snapshot: ${DB_SNAP}"

ensure_linux_users "${DB_SNAP}"
pull_app_secret

if [[ "${SKIP_FILES}" -eq 0 ]]; then
  pull_site_files "${DB_SNAP}"
fi

if [[ "${SKIP_NGINX}" -eq 0 ]]; then
  pull_nginx_php
fi

if [[ "${SKIP_MYSQL}" -eq 0 ]]; then
  pull_and_import_mysql "${DB_SNAP}"
fi

apply_panel_db_local "${DB_SNAP}"
disable_local_backup_jobs

DURATION="$(( $(date +%s) - START_TS ))"
write_status ok "duration_s=${DURATION}"
log_incremental_summary
log_ok "clp-sync pull finished in ${DURATION}s"
trap - EXIT
exit 0
