[Unit]
Description=CloudPanel standby pull (from live master)
Documentation=file:///opt/clp-sync/README.md
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/clp-sync/bin/clp-sync
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=2h

[Install]
WantedBy=multi-user.target
